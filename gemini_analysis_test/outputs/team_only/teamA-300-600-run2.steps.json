        "text": "{\"teams\":{\"team_0\":{\"color\":\"navy blue\"},\"team_1\":{\"color\":\"white\"}},\"plays\":[{\"start\":\"00:05\",\"end\":\"00:18\",\"summary\":\"After white attacks down our right flank, our goalkeeper rushes out to smother the dangerous low cross in the box and clear the danger.\",\"team_0\":{\"relevance\":4,\"players\":[{\"jersey_number\":null,\"position\":\"right-back\",\"tags\":[],\"decision_score\":2,\"execution_score\":2,\"note\":\"Step up earlier to close down the winger and deny the angle for the pass into the box instead of dropping off too deep.\"},{\"jersey_number\":null,\"position\":\"goalkeeper\",\"tags\":[\"Save\"],\"decision_score\":5,\"execution_score\":5,\"note\":\"Decisive sweeper-keeper intervention off the line, reading the danger early and clearing cleanly just like Manuel Neuer.\"}]},\"team_1\":{\"relevance\":0,\"players\":[]}},{\"start\":\"00:39\",\"end\":\"00:52\",\"summary\":\"Our defender blocks the opponent's free kick on the far side and launches a long forward pass for our left winger to chase down the touchline.\",\"team_0\":{\"relevance\":3,\"players\":[{\"jersey_number\":null,\"position\":\"left-back\",\"tags\":[\"Interception\",\"Pass\"],\"decision_score\":4,\"execution_score\":4,\"note\":\"Sharp anticipation to cut out the set piece and immediately turn defense into attack, reminiscent of Andrew Robertson.\"},{\"jersey_number\":null,\"position\":\"left winger\",\"tags\":[\"Dribble\",\"Control\"],\"decision_score\":3,\"execution_score\":3,\"note\":\"Look to take a positive first touch inside toward goal so the defender cannot trap you against the touchline.\"}]},\"team_1\":{\"relevance\":0,\"players\":[]}},{\"start\":\"01:11\",\"end\":\"01:26\",\"summary\":\"Our striker presses the white defenders aggressively on the right side, forcing them to retreat and play all the way back to their goalkeeper.\",\"team_0\":{\"relevance\":3,\"players\":[{\"jersey_number\":null,\"position\":\"striker\",\"tags\":[],\"decision_sco