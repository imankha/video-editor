        "text": "{\"teams\":{\"team_0\":{\"color\":\"Navy blue\"},\"team_1\":{\"color\":\"White\"}},\"plays\":[{\"start\":\"00:02\",\"end\":\"00:16\",\"summary\":\"Our right-back contains an opponent winger near the touchline before being beaten inside, and our centre-back clears the resulting low ball across the penalty area.\",\"team_0\":{\"relevance\":3,\"players\":[{\"jersey_number\":null,\"position\":\"right-back\",\"tags\":[\"Tackle\"],\"decision_score\":3,\"execution_score\":2,\"note\":\"After showing the winger outside, stay patient on your feet and block the inside lane instead of allowing the cutback across the box.\"},{\"jersey_number\":null,\"position\":\"centre-back\",\"tags\":[\"Interception\"],\"decision_score\":4,\"execution_score\":4,\"note\":\"Alert box defending like Virgil van Dijk, stepping into the danger zone to clear the low cross.\"}]},\"team_1\":{\"relevance\":0,\"players\":[]}},{\"start\":\"00:16\",\"end\":\"00:24\",\"summary\":\"Our defensive midfielder closes down an opponent at the edge of the penalty area and wins a strong tackle to stop the second wave of attack.\",\"team_0\":{\"relevance\":4,\"players\":[{\"jersey_number\":null,\"position\":\"defensive midfielder\",\"tags\":[\"Tackle\"],\"decision_score\":5,\"execution_score\":5,\"note\":\"Aggressive, clean ball-winning challenge in front of the back four reminiscent of N'Golo Kante.\"}]},\"team_1\":{\"relevance\":0,\"players\":[]}},{\"start\":\"01:05\",\"end\":\"01:14\",\"summary\":\"Our goalkeeper rushes off his line and dives bravely to smother a dangerous through ball inside the penalty area before the attacker can shoot.\",\"team_0\":{\"relevance\":4,\"players\":[{\"jersey_number\":null,\"position\":\"goalkeeper\",\"tags\":[\"Save\",\"Interception\"],\"decision_score\":5,\"execution_score\":4,\"note\":\"Decisive sweeper-keeper timing off the line to close the space, just like Manuel Neuer.\"}]},\"team_1\":{\"relevance\":0,\"players\":[]}},{\"start\":\"01:32\",\"end\":\"01:41\",\