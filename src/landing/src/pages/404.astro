---
/**
 * 404 page. Cloudflare serves this via `not_found_handling = "404-page"` in
 * wrangler.toml, so a missing URL returns a real 404 status with a useful page
 * -- not a soft 200, and not a bare "Not found" string.
 */
import PageLayout from '../layouts/PageLayout.astro'
import { SPORTS } from '../data/sports'
import { NAV } from '../site'
---

<PageLayout
  title="Page Not Found | ReelBallers"
  description="That page does not exist. Find sports highlight reel guides, camera advice, and recruiting video help here."
  path="/404"
  noindex={true}
>
  <section class="container mx-auto px-4 py-20">
    <div class="max-w-2xl">
      <p class="text-6xl font-bold text-purple-400/50 mb-4">404</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">That page doesn&rsquo;t exist</h1>
      <p class="text-lg text-gray-300 leading-relaxed mb-8">
        The link may be out of date. Here is everything else.
      </p>

      <h2 class="text-lg font-bold text-white mb-3">Main pages</h2>
      <ul class="flex flex-wrap gap-3 mb-8">
        <li>
          <a href="/" class="bg-white/5 hover:bg-white/10 border border-white/10 rounded-full px-4 py-2 text-sm text-gray-300 transition-all inline-block">
            Home
          </a>
        </li>
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class="bg-white/5 hover:bg-white/10 border border-white/10 rounded-full px-4 py-2 text-sm text-gray-300 transition-all inline-block"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <h2 class="text-lg font-bold text-white mb-3">By sport</h2>
      <ul class="flex flex-wrap gap-3">
        {
          SPORTS.map((sport) => (
            <li>
              <a
                href={`/${sport.slug}`}
                class="bg-white/5 hover:bg-white/10 border border-white/10 rounded-full px-4 py-2 text-sm text-gray-300 transition-all inline-flex items-center gap-2"
              >
                <span aria-hidden="true">{sport.emoji}</span>
                {sport.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</PageLayout>
