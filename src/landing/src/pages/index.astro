---
import PageLayout from '../layouts/PageLayout.astro'
import Faq from '../components/Faq.astro'
import Cta from '../components/Cta.astro'
import Testimonials from '../components/Testimonials.astro'
import { BeforeAfterSlider } from '../components/BeforeAfterSlider'
import { TutorialLauncher } from '../components/TutorialLauncher'
import {
  LearnIllustration,
  ElevateIllustration,
  CelebrateIllustration,
} from '../components/Illustrations'
import { HERO_MEDIA } from '../config/heroMedia'
import { SPORTS } from '../data/sports'
import { FACTS, APP_URL, CONTACT_EMAIL, TAGLINE, DEFINITION } from '../site'
import { faqPage, softwareApplication, webSite, webPage, type FaqItem } from '../lib/schema'

const faqs: FaqItem[] = [
  {
    q: 'What is ReelBallers?',
    a: 'ReelBallers is a browser-based video editor that turns raw youth and amateur sports game footage into shareable highlight reels. You upload a game, mark the moments worth keeping, and it handles the cutting, framing, and export.',
  },
  {
    q: 'How do I make a highlight reel from game footage?',
    a: 'Three steps. Upload your game video, watch it and mark the plays worth keeping (tagging each by position and play type), then export. ReelBallers crops and follows your player through each clip and stitches them into one reel you can share with a link.',
  },
  {
    q: 'How does it keep the focus on my player?',
    a: 'You film wide from the sideline with any camera. ReelBallers zooms into the frame and follows the player you choose, then uses AI upscaling to keep the close-up sharp -- so the finished clip looks like it was filmed close-up, following only your athlete. There is no hardware to buy.',
  },
  {
    q: 'What footage does ReelBallers work with?',
    a: 'Any standard video file. That includes iPhone and Android video, GoPro and other action cameras, XbotGo and similar auto-follow mounts, camcorders, and match video exported from team systems like Veo, Trace, or Hudl. There is no hardware to buy and no camera integration to set up.',
  },
  {
    q: 'Which sports does ReelBallers support?',
    a: `${FACTS.sportCount} sports: soccer, basketball, American football, flag football, baseball, softball, volleyball, lacrosse, hockey, rugby, and tennis. Each has its own tagging presets, covering ${FACTS.positionCount} positions and ${FACTS.playTypeCount} play types in total.`,
  },
  {
    q: 'Do I need to buy a special camera?',
    a: 'No. ReelBallers is built for footage you already have, filmed on whatever you already own. That is the main difference from camera ecosystems like Veo, Trace, or Hudl, which require buying or renting hardware and typically a subscription tied to it.',
  },
  {
    q: 'How much does ReelBallers cost?',
    a: 'Free to start. You can upload a game and build a reel without paying up front.',
  },
  {
    q: 'What does the person I share the reel with need?',
    a: `Just ${FACTS.viewerRequirement}. A shared reel opens as a link and plays at full resolution, so grandparents, coaches, and recruiters can watch without signing up for anything.`,
  },
  {
    q: 'Can I make a vertical version for Instagram or TikTok?',
    a: 'Yes. The same set of clips can be exported in more than one aspect ratio, so a wide recruiting cut and a vertical social version come from the same work rather than being edited twice.',
  },
]

const schemas = [
  webSite(),
  softwareApplication(),
  webPage({
    name: 'Turn game footage into highlight reels automatically',
    description: 'ReelBallers turns raw sports game footage into shareable highlight reels.',
    path: '/',
  }),
  faqPage(faqs),
]

const steps = [
  {
    n: 1,
    title: 'Upload your game',
    body: 'Drop in the footage you already filmed -- phone, GoPro, action camera, or an export from a team camera system. No conversion, no special format.',
  },
  {
    n: 2,
    title: 'Mark the plays that matter',
    body: 'Watch the game and tag the moments worth keeping by position and play type. Rate them, add notes, and build a searchable library of your athlete’s best work.',
  },
  {
    n: 3,
    title: 'Export and share one link',
    body: 'ReelBallers puts the focus on your player &mdash; zoomed in and following every play &mdash; adds the spotlight, and stitches it into one sharp reel. Share it with a single link.',
  },
]
---

<PageLayout
  title="Turn Game Footage Into Highlight Reels | ReelBallers"
  description="Upload raw game footage and get a highlight reel that follows your player automatically. Works with any camera, 11 sports, no hardware to buy. Free."
  path="/"
  schemas={schemas}
>
  <!-- Hero. The brand tagline leads; one short line carries the search intent.
       The full factual definition lives in the "What is ReelBallers?" block
       below rather than here -- it still sits high in the DOM for AI engines to
       quote, without turning the hero into a paragraph of body copy. -->
  <section class="container mx-auto px-4 pt-12 pb-8">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-4xl md:text-6xl font-bold text-white mb-5 leading-tight">{TAGLINE}</h1>
      <p class="text-lg md:text-2xl text-gray-300">
        Film the game from the sideline like you always do. ReelBallers puts the focus on your
        athlete &mdash; zoomed in, followed through every play, in crisp HD.
      </p>
    </div>

    <div class="mt-12">
      <BeforeAfterSlider
        client:load
        beforeSrc={HERO_MEDIA.before.src}
        afterSrc={HERO_MEDIA.after.src}
        beforePoster={HERO_MEDIA.before.poster}
        afterPoster={HERO_MEDIA.after.poster}
        label={HERO_MEDIA.alt}
      />
      <p class="text-center text-sm text-gray-400 mt-4">
        Same play, same phone. Left: what you filmed. Right: your athlete, in focus.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row justify-center items-center gap-4 mt-4">
      <button
        type="button"
        data-tutorial="full"
        class="px-8 py-3 bg-white/5 hover:bg-white/10 border border-white/15 text-white font-semibold rounded-full text-lg transition-all"
      >
        See how it works
      </button>
      <a
        href={APP_URL}
        data-cta
        class="px-8 py-3 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold rounded-full text-lg shadow-lg shadow-purple-500/25 transition-all"
      >
        Get started free
      </a>
    </div>
  </section>

  <!-- The quotable definition. Compact by design: one bolded sentence an AI
       engine can lift whole, plus the three facts that qualify it. -->
  <section class="container mx-auto px-4 py-12" aria-labelledby="what-is-heading">
    <div class="max-w-3xl mx-auto text-center">
      <h2 id="what-is-heading" class="text-sm font-semibold uppercase tracking-wider text-purple-400 mb-4">
        What is ReelBallers?
      </h2>
      <p class="text-lg text-gray-200 leading-relaxed">{DEFINITION}</p>
      <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 mt-6 text-sm text-gray-400">
        <li>{FACTS.sportCount} sports</li>
        <li aria-hidden="true">&middot;</li>
        <li>Works with any camera</li>
        <li aria-hidden="true">&middot;</li>
        <li>Nothing to install</li>
        <li aria-hidden="true">&middot;</li>
        <li>Free to start</li>
      </ul>
    </div>
  </section>

  <!-- How it works -->
  <section class="container mx-auto px-4 py-16" aria-labelledby="how-heading">
    <h2 id="how-heading" class="text-3xl md:text-4xl font-bold text-white text-center mb-4">
      How it works
    </h2>
    <p class="text-gray-400 text-center max-w-2xl mx-auto mb-12">
      Three steps from a two-hour game file to a reel you can send to anyone.
    </p>
    <ol class="grid gap-8 md:grid-cols-3 max-w-5xl mx-auto">
      {
        steps.map((step) => (
          <li class="bg-white/5 border border-white/10 rounded-2xl p-6">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-purple-500 to-indigo-600 flex items-center justify-center text-white font-bold mb-4">
              {step.n}
            </div>
            <h3 class="text-xl font-bold text-white mb-2">{step.title}</h3>
            <p class="text-gray-300 leading-relaxed" set:html={step.body} />
          </li>
        ))
      }
    </ol>
    <p class="text-center mt-8">
      <a href="/how-it-works" class="text-purple-400 hover:text-purple-300 font-medium transition-colors">
        See the full walkthrough &rarr;
      </a>
    </p>
  </section>

  <!-- Showcase: static markup, tutorial modal opens via the launcher island -->
  <section class="container mx-auto px-4 py-8 space-y-20 md:space-y-28" aria-labelledby="what-heading">
    <h2 id="what-heading" class="sr-only">What ReelBallers does</h2>

    <div class="flex flex-col md:flex-row items-center gap-8 md:gap-16">
      <div class="w-full md:w-[60%] md:order-first">
        <button type="button" data-tutorial="learn" class="group relative block w-full rounded-2xl" aria-label="Play the Annotate tutorial">
          <LearnIllustration className="shadow-2xl shadow-purple-500/10 group-hover:scale-[1.02] transition-transform duration-300" />
        </button>
      </div>
      <div class="w-full md:w-[40%]">
        <h3 class="text-3xl md:text-4xl font-bold bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent pb-1 mb-4">
          Educate
        </h3>
        <p class="text-lg text-gray-300 leading-relaxed">
          Leave notes on the moments that matter. Your athlete reviews at their own pace &mdash; no
          sideline lectures, no pressure. Rate and tag plays by type, and tag teammates so everyone
          gets their clips.
        </p>
      </div>
    </div>

    <div class="flex flex-col md:flex-row items-center gap-8 md:gap-16">
      <div class="w-full md:w-[60%]">
        <button type="button" data-tutorial="elevate" class="group relative block w-full rounded-2xl" aria-label="Play the Framing and Highlights tutorials">
          <ElevateIllustration className="shadow-2xl shadow-purple-500/10 group-hover:scale-[1.02] transition-transform duration-300" />
        </button>
      </div>
      <div class="w-full md:w-[40%] md:order-first">
        <h3 class="text-3xl md:text-4xl font-bold bg-gradient-to-r from-amber-400 to-orange-500 bg-clip-text text-transparent pb-1 mb-4">
          Elevate
        </h3>
        <p class="text-lg text-gray-300 leading-relaxed">
          Your athlete, in focus. Your wide sideline video becomes close-up footage that follows
          your player through every play &mdash; centered, sharp, impossible to lose in the crowd.
          Animated spotlights tell everyone exactly who to watch.
        </p>
        <p class="text-sm text-gray-500 mt-2">
          Under the hood: AI tracking, reframing, and upscaling toward {FACTS.upscaleTarget}.
        </p>
      </div>
    </div>

    <div class="flex flex-col md:flex-row items-center gap-8 md:gap-16">
      <div class="w-full md:w-[60%] md:order-first">
        <button type="button" data-tutorial="celebrate" class="group relative block w-full rounded-2xl" aria-label="Play the Share tutorial">
          <CelebrateIllustration className="shadow-2xl shadow-purple-500/10 group-hover:scale-[1.02] transition-transform duration-300" />
        </button>
      </div>
      <div class="w-full md:w-[40%]">
        <h3 class="text-3xl md:text-4xl font-bold bg-gradient-to-r from-pink-400 to-rose-500 bg-clip-text text-transparent pb-1 mb-4">
          Celebrate
        </h3>
        <p class="text-lg text-gray-300 leading-relaxed">
          Share the finished reel with one link. Family watches in full resolution on a phone,
          coaches get the highlights, and it is ready to post to Instagram or TikTok in a tap.
        </p>
      </div>
    </div>
  </section>

  <!-- The problem -->
  <section class="container mx-auto px-4 py-16" aria-labelledby="problem-heading">
    <div class="bg-white/5 backdrop-blur-lg rounded-2xl p-8 md:p-10 max-w-3xl mx-auto border border-white/10">
      <h2 id="problem-heading" class="text-2xl md:text-3xl font-bold text-white mb-6 text-center">
        Why highlight reels never get made
      </h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <h3 class="text-red-400 font-semibold mb-3">Editing by hand</h3>
          <ul class="text-gray-400 text-sm space-y-2">
            <li>Watch 10+ hours of game footage</li>
            <li>Manually timestamp every good play</li>
            <li>Juggle multiple editing tools</li>
            <li>Re-export every time you find a better clip</li>
            <li>Weeks to make one highlight reel</li>
          </ul>
        </div>
        <div>
          <h3 class="text-green-400 font-semibold mb-3">With ReelBallers</h3>
          <ul class="text-gray-400 text-sm space-y-2">
            <li>Upload your games once</li>
            <li>Mark key plays as you watch</li>
            <li>Build a searchable library of clips</li>
            <li>Generate reels from simple queries</li>
            <li>Reuse the same clips across formats</li>
          </ul>
        </div>
      </div>
      <p class="text-center mt-8">
        <a href="/vs/editing-by-hand" class="text-purple-400 hover:text-purple-300 font-medium transition-colors">
          Full comparison: ReelBallers vs editing by hand &rarr;
        </a>
      </p>
    </div>
  </section>

  <!-- Sports -->
  <section class="container mx-auto px-4 py-16" aria-labelledby="sports-heading">
    <h2 id="sports-heading" class="text-2xl md:text-3xl font-bold text-white mb-2 text-center">
      Built for {FACTS.sportCount} sports
    </h2>
    <p class="text-gray-400 text-sm mb-8 text-center">
      Each sport has its own tagging presets &mdash; {FACTS.positionCount} positions and {FACTS.playTypeCount} play
      types in total. Filming{' '}
      <a href="/soccer" class="text-purple-400 hover:text-purple-300 transition-colors">soccer</a>? Start there.
      Don&rsquo;t see yours?{' '}
      <a href={`mailto:${CONTACT_EMAIL}?subject=New%20sport%20request`} class="text-purple-400 hover:text-purple-300 transition-colors">
        Request it
      </a>.
    </p>
    <ul class="flex flex-wrap justify-center gap-3 max-w-4xl mx-auto">
      {
        SPORTS.map((sport) => (
          <li>
            <a
              href={`/${sport.slug}`}
              class="flex items-center gap-2 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-purple-400/50 rounded-full px-4 py-2 transition-all"
            >
              <span class="text-xl leading-none" aria-hidden="true">
                {sport.emoji}
              </span>
              <span class="text-gray-300 text-sm font-medium">{sport.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <Testimonials />

  <Faq items={faqs} />

  <Cta />

  <TutorialLauncher client:idle />
</PageLayout>
