---
import PageLayout from '../layouts/PageLayout.astro'
import Faq from '../components/Faq.astro'
import Cta from '../components/Cta.astro'
import Testimonials from '../components/Testimonials.astro'
import { BeforeAfterSlider } from '../components/BeforeAfterSlider'
import {
  LearnIllustration,
  ElevateIllustration,
  CelebrateIllustration,
} from '../components/Illustrations'
import { HERO_MEDIA } from '../config/heroMedia'
import { SPORTS } from '../data/sports'
import { FACTS, APP_URL, CONTACT_EMAIL, DEFINITION, HERO_HEADLINE_LEAD, HERO_HEADLINE_ACCENT, HERO_HEADLINE_TAIL, HERO_SUBLINE, HERO_TRUST_LINE, TUTORIAL_URL, TUTORIAL_THUMBNAIL } from '../site'
// Pricing derives from src/backend/app/pricing.json through the app's pricing module
// (single source, T10210); the storage rule (1 credit per GB per 30 days, T13310) is the app's own and
// independent of the ladder, so the worked example below recomputes from it alone.
import {
  CREDIT_PACKS,
  BEST_VALUE_PACK,
  packPriceUsd,
  costAtBestRateUsd,
  CREDITS_PER_PLAY,
  FEATURED_PACK_KEY,
  approxPlays,
} from '@editor/config/pricing'
import { calculateUploadCost } from '@editor/utils/storageCost'
import { faqPage, softwareApplication, webSite, webPage, type FaqItem } from '../lib/schema'

// Worked pricing example: a 90-minute game (~6 GB) stored 30 days, three 15-second highlights.
const EXAMPLE_GAME_GB = 6
const EXAMPLE_HIGHLIGHT_SECONDS = 15
// "three highlights" is spelled out in the prose below; keep the 3 here in step with it.
const exampleUploadCredits = calculateUploadCost(EXAMPLE_GAME_GB * 1024 ** 3) // storage + auto-export surcharge
const exampleExportCredits = 3 * EXAMPLE_HIGHLIGHT_SECONDS * FACTS.creditsPerExportSecond
const exampleTotalCredits = exampleUploadCredits + exampleExportCredits
const exampleTotalUsd = costAtBestRateUsd(exampleTotalCredits).toFixed(2)
// Mirror BuyCreditsModal.jsx's `pack.credits.toLocaleString()` (thousands separator at
// >=1000 credits). Pinned to en-US so the static build is locale-independent.
const formatCredits = (credits: number) => credits.toLocaleString('en-US')

const faqs: FaqItem[] = [
  {
    q: 'What is ReelBallers?',
    a: 'ReelBallers is a browser-based video editor that turns raw youth and amateur sports game footage into shareable highlight reels. You upload your video, mark the moments worth keeping and frame your player, and it handles the cutting and generation.',
  },
  {
    q: 'How do I make a highlight reel from game footage?',
    a: 'Three steps. Upload your video, watch it and mark the plays worth keeping (tagging each with a play type), then frame your player with a few drags. ReelBallers smooths the motion, upscales it, and turns each play into a sharp highlight you can share with a link.',
  },
  {
    q: 'How does it keep the focus on my player?',
    a: 'You film wide from the sideline with any camera. You mark the best plays and frame your athlete, ReelBallers smooths the motion, then AI upscaling keeps the close-up sharp -- so the finished clip looks like it was filmed close-up on your athlete alone. There is no hardware to buy.',
  },
  {
    q: 'What footage does ReelBallers work with?',
    a: 'Any standard video file. That includes match video exported from team systems like Veo, Trace, or Hudl, iPhone and Android video, GoPro and other action cameras, XbotGo and similar auto-follow mounts, and camcorders. There is no hardware to buy and no camera integration to set up.',
  },
  {
    q: 'Which sports does ReelBallers support?',
    a: `${FACTS.sportCount} sports: soccer, basketball, American football, flag football, baseball, softball, volleyball, lacrosse, hockey, rugby, and tennis. Each has its own tagging presets, ${FACTS.playTypeCount} play types in total.`,
  },
  {
    q: 'Do I need to buy a special camera?',
    a: 'No. ReelBallers is built for footage you already have, filmed on whatever you already own. That is the main difference from camera ecosystems like Veo, Trace, or Hudl, which require buying or renting hardware and typically a subscription tied to it.',
  },
  {
    q: 'How much does ReelBallers cost?',
    a: `Free to start, and there is no subscription. You get ${FACTS.freeCredits} free credits at signup, then buy credits only when you need more and pay only for the AI you use: generating a highlight costs ${FACTS.creditsPerExportSecond} credit per second of finished video, and storing an uploaded game costs credits too. No monthly fee, nothing to cancel, and credits never expire.`,
  },
  {
    q: 'What does one game cost?',
    a: `It depends on how many plays you pull out of it and how long they are. For example: upload a full 90-minute game (about ${EXAMPLE_GAME_GB} GB) and store it for 30 days for ${exampleUploadCredits} credits (1 credit per GB per 30 days, plus 1 for the automatic highlight export). Generate three ${EXAMPLE_HIGHLIGHT_SECONDS}-second highlights from it for ${exampleExportCredits} credits, at 1 credit per second of finished video, rounded to the nearest second. That is ${exampleTotalCredits} credits total, about $${exampleTotalUsd} at the best-value rate. Across real exports, a typical play uses about ${CREDITS_PER_PLAY} credits including its share of the upload.`,
  },
  {
    q: 'What does the person I share the highlight with need?',
    a: `Just ${FACTS.viewerRequirement}. A shared highlight opens as a link and plays at full resolution, so grandparents, coaches, and recruiters can watch without signing up for anything.`,
  },
  {
    q: 'Can I make a vertical version for Instagram or TikTok?',
    a: 'Yes. The same highlight can be generated in more than one aspect ratio, so a wide recruiting version and a vertical social version come from the same work rather than being edited twice.',
  },
]

const schemas = [
  webSite(),
  softwareApplication(),
  webPage({
    name: 'Transform game film into high-quality highlights in minutes',
    description: 'ReelBallers turns raw sports game footage into shareable highlight reels.',
    path: '/',
  }),
  faqPage(faqs),
]

const steps = [
  {
    n: 1,
    title: 'Upload your video(s)',
    body: 'Drop in the footage you already filmed -- your phone, an export from Veo, Trace, or another team camera system, or any action camera. No conversion, no special format.',
  },
  {
    n: 2,
    title: 'Mark the plays that matter',
    body: 'Watch the game and tag the moments worth keeping by play type. Rate them, add notes, and build a library of your athlete’s best work.',
  },
  {
    n: 3,
    title: 'Generate and share one link',
    body: 'You put the focus on your athlete: a few drags of the crop box in the wide shot. ReelBallers smooths the motion, adds the spotlight, and produces one sharp highlight. Share it with a single link.',
  },
]
---

<PageLayout
  title="Turn Game Footage Into Highlight Reels | ReelBallers"
  description="Transform game film into high-quality highlights in minutes using AI upscaling. Any camera, 11 sports, no hardware, no subscription. Free to start."
  path="/"
  schemas={schemas}
>
  <!-- Hero (T13350, set 1b "Spotlight"). Two short lines of promise, one primary action, one
       trust line, then the phone. The full factual definition lives in the "What is
       ReelBallers?" block below, high in the DOM for AI engines to quote. Primary CTA is first
       in DOM order. TAGLINE still feeds the meta description wording and the about page. -->
  <section class="container mx-auto px-4 pt-10 lg:pt-14 pb-12">
    <div class="grid lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] items-center gap-12 max-w-6xl mx-auto">
      <div class="max-w-2xl mx-auto lg:mx-0 text-center lg:text-left">
        <h1 class="font-display font-extrabold tracking-[-0.02em] leading-[1.05] text-[2.5rem] md:text-5xl lg:text-[3.25rem] text-white mb-5">
          {HERO_HEADLINE_LEAD}<br class="hidden lg:block" />
          <span class="text-amber-300">{HERO_HEADLINE_ACCENT}</span> {HERO_HEADLINE_TAIL}
        </h1>
        <p class="text-lg md:text-xl text-gray-300 leading-relaxed max-w-[34ch] mx-auto lg:mx-0 mb-8">
          {HERO_SUBLINE}
        </p>
        <div class="flex flex-col sm:flex-row sm:flex-wrap justify-center lg:justify-start gap-3 mb-4">
          <a
            href={APP_URL}
            data-cta
            class="inline-flex items-center justify-center min-h-[52px] sm:min-h-0 px-7 py-3 bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold rounded-full text-lg shadow-lg shadow-amber-500/20 transition-all"
          >
            Start free
          </a>
          <a
            href="#how-heading"
            class="inline-flex items-center justify-center px-7 py-3 bg-white/5 hover:bg-white/10 border border-white/15 text-white font-semibold rounded-full text-lg transition-all"
          >
            See how it works
          </a>
        </div>
        <p class="text-sm text-slate-400">{HERO_TRUST_LINE}</p>
        <p class="mt-3 text-sm">
          <a href={TUTORIAL_URL} target="_blank" rel="noopener" class="text-purple-300 hover:text-purple-200 font-medium transition-colors">
            &#9654; Watch the tutorial
          </a>
        </p>
      </div>

      <div class="relative w-full max-w-[300px] md:max-w-none mx-auto">
        <div
          aria-hidden="true"
          class="absolute -z-10 pointer-events-none left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[140%] h-[140%]"
          style="background: radial-gradient(closest-side, rgba(251,191,36,0.16), rgba(168,85,247,0.10) 55%, transparent 75%)"
        ></div>
        <BeforeAfterSlider
          client:load
          beforeSrc={HERO_MEDIA.before.src}
          afterSrc={HERO_MEDIA.after.src}
          beforePoster={HERO_MEDIA.before.poster}
          afterPoster={HERO_MEDIA.after.poster}
          label={HERO_MEDIA.alt}
          frameClassName="md:w-[300px] md:h-[533px]"
          beforeLabel="Your footage"
          afterLabel="In focus"
        />
      </div>
    </div>
  </section>

  <!-- The quotable definition. Compact by design: one bolded sentence an AI
       engine can lift whole, plus the three facts that qualify it. -->
  <section class="container mx-auto px-4 py-12" aria-labelledby="what-is-heading">
    <div class="max-w-3xl mx-auto text-center">
      <h2 id="what-is-heading" class="text-sm font-semibold uppercase tracking-wider text-purple-400 mb-4">
        What is ReelBallers?
      </h2>
      <p class="text-lg text-gray-200 leading-relaxed">{DEFINITION}</p>
      <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 mt-6 text-sm text-gray-400">
        <li>{FACTS.sportCount} sports</li>
        <li aria-hidden="true">&middot;</li>
        <li>No subscription</li>
        <li aria-hidden="true">&middot;</li>
        <li>Works with any camera</li>
        <li aria-hidden="true">&middot;</li>
        <li>Nothing to install</li>
        <li aria-hidden="true">&middot;</li>
        <li>Free to start</li>
      </ul>
    </div>
  </section>

  <!-- How it works -->
  <section class="container mx-auto px-4 py-16" aria-labelledby="how-heading">
    <h2 id="how-heading" class="text-3xl md:text-4xl font-bold text-white text-center mb-4">
      How it works
    </h2>
    <p class="text-gray-400 text-center max-w-2xl mx-auto mb-12">
      Three steps from a two-hour game file to a highlight you can send to anyone.
    </p>
    <ol class="grid gap-8 md:grid-cols-3 max-w-5xl mx-auto">
      {
        steps.map((step) => (
          <li class="bg-white/5 border border-white/10 rounded-2xl p-6">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-purple-500 to-indigo-600 flex items-center justify-center text-white font-bold mb-4">
              {step.n}
            </div>
            <h3 class="text-xl font-bold text-white mb-2">{step.title}</h3>
            <p class="text-gray-300 leading-relaxed" set:html={step.body} />
          </li>
        ))
      }
    </ol>
    <a
      href={TUTORIAL_URL}
      target="_blank"
      rel="noopener"
      class="group block max-w-3xl mx-auto mt-12 rounded-2xl overflow-hidden border border-white/10 bg-white/5 hover:border-purple-400/50 transition-colors"
    >
      <div class="relative aspect-video bg-black">
        <img
          src={TUTORIAL_THUMBNAIL}
          alt="ReelBallers tutorial video on YouTube"
          width="480"
          height="360"
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover opacity-90 group-hover:opacity-100 transition-opacity"
        />
        <span class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
          <span class="w-16 h-16 rounded-full bg-amber-400 text-slate-950 flex items-center justify-center text-2xl shadow-lg shadow-black/40 group-hover:scale-105 transition-transform">&#9654;</span>
        </span>
      </div>
      <p class="px-5 py-4 text-center text-white font-semibold">
        Watch the full tutorial <span class="text-gray-400 font-normal">on YouTube</span>
      </p>
    </a>
    <p class="text-center mt-8">
      <a href="/how-it-works" class="text-purple-400 hover:text-purple-300 font-medium transition-colors">
        See every step &rarr;
      </a>
    </p>
  </section>

  <!-- Showcase: static markup. The tutorial video triggers were removed by T12780
       (the old videos show retired screens); T10320 re-adds them with the reshoot. -->
  <section class="container mx-auto px-4 py-8 space-y-20 md:space-y-28" aria-labelledby="what-heading">
    <h2 id="what-heading" class="sr-only">What ReelBallers does</h2>

    <div class="flex flex-col md:flex-row items-center gap-8 md:gap-16">
      <div class="w-full md:w-[60%] md:order-first">
        <div class="relative block w-full rounded-2xl">
          <LearnIllustration className="shadow-2xl shadow-purple-500/10" />
        </div>
      </div>
      <div class="w-full md:w-[40%]">
        <h3 class="text-3xl md:text-4xl font-bold bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent pb-1 mb-4">
          Educate
        </h3>
        <p class="text-lg text-gray-300 leading-relaxed">
          Leave notes on the moments that matter. Your athlete reviews at their own pace, no
          sideline lectures, no pressure. Rate and tag plays by type, and tag teammates so everyone
          gets their clips.
        </p>
      </div>
    </div>

    <div class="flex flex-col md:flex-row items-center gap-8 md:gap-16">
      <div class="w-full md:w-[60%]">
        <div class="relative block w-full rounded-2xl">
          <ElevateIllustration className="shadow-2xl shadow-purple-500/10" />
        </div>
      </div>
      <div class="w-full md:w-[40%] md:order-first">
        <h3 class="text-3xl md:text-4xl font-bold bg-gradient-to-r from-amber-400 to-orange-500 bg-clip-text text-transparent pb-1 mb-4">
          Elevate
        </h3>
        <p class="text-lg text-gray-300 leading-relaxed">
          Your athlete, in focus. A few drags of the crop box and your wide sideline video becomes
          close-up footage through every play: centered, sharp, impossible to lose in the crowd.
          Animated spotlights tell everyone exactly who to watch.
        </p>
        <p class="text-sm text-gray-500 mt-2">
          Under the hood: AI-proposed player boxes, motion interpolation between your marks, and
          upscaling toward {FACTS.upscaleTarget}.
        </p>
      </div>
    </div>

    <div class="flex flex-col md:flex-row items-center gap-8 md:gap-16">
      <div class="w-full md:w-[60%] md:order-first">
        <div class="relative block w-full rounded-2xl">
          <CelebrateIllustration className="shadow-2xl shadow-purple-500/10" />
        </div>
      </div>
      <div class="w-full md:w-[40%]">
        <h3 class="text-3xl md:text-4xl font-bold bg-gradient-to-r from-pink-400 to-rose-500 bg-clip-text text-transparent pb-1 mb-4">
          Celebrate
        </h3>
        <p class="text-lg text-gray-300 leading-relaxed">
          Share the finished highlight with one link. Family watches in full resolution on a phone,
          coaches get the highlights, and it is ready to post to Instagram or TikTok in a tap.
        </p>
      </div>
    </div>
  </section>

  <!-- The problem -->
  <section class="container mx-auto px-4 py-16" aria-labelledby="problem-heading">
    <div class="bg-white/5 backdrop-blur-lg rounded-2xl p-8 md:p-10 max-w-3xl mx-auto border border-white/10">
      <h2 id="problem-heading" class="text-2xl md:text-3xl font-bold text-white mb-6 text-center">
        Why highlight reels never get made
      </h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <h3 class="text-red-400 font-semibold mb-3">Editing by hand</h3>
          <ul class="text-gray-400 text-sm space-y-2">
            <li>Watch 10+ hours of game footage</li>
            <li>Manually timestamp every good play</li>
            <li>Juggle multiple editing tools</li>
            <li>Re-export every time you find a better clip</li>
            <li>Weeks to make one highlight reel</li>
          </ul>
        </div>
        <div>
          <h3 class="text-green-400 font-semibold mb-3">With ReelBallers</h3>
          <ul class="text-gray-400 text-sm space-y-2">
            <li>Upload your games once</li>
            <li>Mark key plays as you watch</li>
            <li>Build a library of clips</li>
            <li>Turn any marked play into a highlight</li>
            <li>Generate one highlight in multiple formats</li>
          </ul>
        </div>
      </div>
      <p class="text-center mt-8">
        <a href="/vs/editing-by-hand" class="text-purple-400 hover:text-purple-300 font-medium transition-colors">
          Full comparison: ReelBallers vs editing by hand &rarr;
        </a>
      </p>
    </div>
  </section>

  <!-- Sports -->
  <section class="container mx-auto px-4 py-16" aria-labelledby="sports-heading">
    <h2 id="sports-heading" class="text-2xl md:text-3xl font-bold text-white mb-2 text-center">
      Built for {FACTS.sportCount} sports
    </h2>
    <p class="text-gray-400 text-sm mb-8 text-center">
      Each sport has its own tagging presets, {FACTS.playTypeCount} play
      types in total.
      Don&rsquo;t see yours?{' '}
      <a href={`mailto:${CONTACT_EMAIL}?subject=New%20sport%20request`} class="text-purple-400 hover:text-purple-300 transition-colors">
        Request it
      </a>.
    </p>
    <ul class="flex flex-wrap justify-center gap-3 max-w-4xl mx-auto">
      {
        SPORTS.map((sport) => (
          <li>
            <a
              href={`/${sport.slug}`}
              class="flex items-center gap-2 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-purple-400/50 rounded-full px-4 py-2 transition-all"
            >
              <span class="text-xl leading-none" aria-hidden="true">
                {sport.emoji}
              </span>
              <span class="text-gray-300 text-sm font-medium">{sport.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="container mx-auto px-4 py-16 scroll-mt-20" aria-labelledby="pricing-heading">
    <div class="max-w-2xl mx-auto text-center mb-12">
      <h2 id="pricing-heading" class="text-sm font-semibold uppercase tracking-wider text-purple-400 mb-4">
        Pricing
      </h2>
      <p class="font-display font-extrabold tracking-[-0.02em] leading-[1.05] text-[2.25rem] md:text-5xl text-white mb-4">
        No subscription.<br />
        Pay <span class="text-amber-300">only</span> for the AI you use.
      </p>
      <p class="text-lg md:text-xl text-gray-300 leading-relaxed [text-wrap:balance]">
        Start with {FACTS.freeCredits} free credits. A typical play uses ~{CREDITS_PER_PLAY}.
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-3 max-w-4xl mx-auto mb-10">
      {
        CREDIT_PACKS.map((pack) => (
          <div
            class:list={[
              'relative border rounded-2xl p-6 text-center',
              pack.key === FEATURED_PACK_KEY
                ? 'border-amber-400/60 bg-amber-400/[0.06] shadow-lg shadow-amber-500/10'
                : 'border-white/10 bg-white/5',
            ]}
          >
            {pack.key === FEATURED_PACK_KEY && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-amber-400 text-slate-950 text-xs font-bold px-3 py-1 rounded-full whitespace-nowrap">
                Most Popular
              </span>
            )}
            {pack.key === BEST_VALUE_PACK.key && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 border border-white/20 bg-gray-800 text-gray-200 text-xs font-semibold px-3 py-1 rounded-full whitespace-nowrap">
                Best Value
              </span>
            )}
            <div class="font-display font-extrabold tracking-[-0.02em] leading-none text-5xl text-white">
              ~{approxPlays(pack.credits)} <span class="text-amber-300">plays</span>
            </div>
            <div class="mt-4 text-2xl font-bold text-white">${packPriceUsd(pack).toFixed(2)}</div>
            <div class="text-sm text-slate-400">{formatCredits(pack.credits)} credits</div>
          </div>
        ))
      }
    </div>

    <div class="flex flex-col sm:flex-row justify-center gap-3 mb-5">
      <a
        href={APP_URL}
        data-cta
        class="inline-flex items-center justify-center min-h-[52px] sm:min-h-0 px-7 py-3 bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold rounded-full text-lg shadow-lg shadow-amber-500/20 transition-all"
      >
        Start free
      </a>
      <a
        href="#faq"
        class="inline-flex items-center justify-center px-7 py-3 bg-white/5 hover:bg-white/10 border border-white/15 text-white font-semibold rounded-full text-lg transition-all"
      >
        How credits work
      </a>
    </div>
    <p class="text-sm text-slate-400 text-center max-w-2xl mx-auto">
      {FACTS.creditsPerExportSecond} credit per second of finished video. Storage 1 credit per GB per 30 days. Credits never expire.
      <br />
      Play counts are estimates, not guarantees.
    </p>

    <div class="max-w-3xl mx-auto mt-12 text-center">
      <h3 class="text-white font-semibold mb-2">How long we keep things</h3>
      <p class="text-gray-300 leading-relaxed">
        Your uploaded game is kept for 30 days, and you can extend it anytime. Highlights you generate are
        kept for good and are free to store. A draft you haven't generated stays viewable, but you need its
        source to re-edit or generate it, so finish the ones you want to keep before the 30 days are up.
      </p>
    </div>
  </section>

  <Testimonials />

  <Faq items={faqs} />

  <Cta />

</PageLayout>
