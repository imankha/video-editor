---
/**
 * About / Our Story.
 *
 * The founder story section is INTENTIONALLY ABSENT until the owner supplies
 * their draft -- shipping placeholder narrative copy would be worse than
 * shipping none. Everything here is factual and verifiable, which is also what
 * makes this page useful for entity resolution: it is where an AI engine
 * confirms what ReelBallers is, who it serves, and how to reach it.
 *
 * When the founder story arrives, add it as a section directly beneath the H1
 * answer paragraph and set `foundingDate`/`founder` on the Organization node in
 * lib/schema.ts.
 */
import PageLayout from '../layouts/PageLayout.astro'
import Cta from '../components/Cta.astro'
import Faq from '../components/Faq.astro'
import { SPORTS } from '../data/sports'
import { BRAND, TAGLINE, DEFINITION, FACTS, CONTACT_EMAIL, INPUT_SOURCES } from '../site'
import { faqPage, softwareApplication, webPage, breadcrumbs, type FaqItem } from '../lib/schema'

const path = '/about'

const faqs: FaqItem[] = [
  {
    q: 'What is ReelBallers?',
    a: DEFINITION,
  },
  {
    q: 'Who is ReelBallers for?',
    a: 'Parents of youth and amateur athletes, athletes roughly 13-18 building recruiting material, club coaches who need per-player clips, and clubs that already capture match footage but cannot easily give families individual reels.',
  },
  {
    q: 'Does ReelBallers sell cameras or hardware?',
    a: 'No. It is software that runs in a web browser and works with footage you already have. There is nothing to buy, rent, or install.',
  },
  {
    q: 'How do I contact ReelBallers?',
    a: `Email ${CONTACT_EMAIL}.`,
  },
]

const schemas = [
  softwareApplication(),
  webPage({ name: `About ${BRAND}`, description: DEFINITION, path }),
  breadcrumbs([{ name: 'About', path }]),
  faqPage(faqs),
]
---

<PageLayout
  title="About ReelBallers"
  description="ReelBallers turns raw youth sports game footage into highlight reels. What it is, who it is for, and how it differs from camera systems and editors."
  path={path}
  schemas={schemas}
  trail={[{ name: 'About', path }]}
  current="/about"
>
  <section class="container mx-auto px-4 pt-10 pb-10">
    <div class="max-w-3xl">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-6 leading-tight">About ReelBallers</h1>
      <p class="text-lg md:text-xl text-gray-300 leading-relaxed">{TAGLINE}</p>
    </div>
  </section>

  <div class="container mx-auto px-4 py-8">
    <div class="max-w-3xl space-y-12">
      <section>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">The problem it exists to solve</h2>
        <p class="text-gray-300 leading-relaxed mb-4">
          Youth sports families capture an enormous amount of video and watch almost none of it. The
          footage is wide, the athlete is small in the frame, and finding the four minutes that
          matter inside a two-hour match is an evening of work with ordinary editing software.
        </p>
        <p class="text-gray-300 leading-relaxed mb-4">
          The industry&rsquo;s answer has largely been better cameras: fixed systems that
          record the whole match automatically. That solves capture, which was never the hard part.
          It leaves the actual problem untouched: turning a long recording into something one
          specific family, coach, or recruiter actually wants to watch.
        </p>
        <p class="text-gray-300 leading-relaxed">
          ReelBallers works on that second half. It assumes you already have footage, from whatever
          camera you happen to own, and concentrates on the editing: finding the plays, following
          one chosen player through them, and producing something shareable.
        </p>
      </section>

      <section>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">What it does</h2>
        <ul class="space-y-3 text-gray-300">
          <li class="flex gap-3">
            <span class="text-purple-400 shrink-0" aria-hidden="true">&#10003;</span>
            <span>
              Play tagging for {FACTS.sportCount} sports, covering {FACTS.positionCount} positions and
              {' '}{FACTS.playTypeCount} play types.
            </span>
          </li>
          <li class="flex gap-3">
            <span class="text-purple-400 shrink-0" aria-hidden="true">&#10003;</span>
            <span>Automatic follow-framing that keeps a chosen player in frame across wide footage.</span>
          </li>
          <li class="flex gap-3">
            <span class="text-purple-400 shrink-0" aria-hidden="true">&#10003;</span>
            <span>AI upscaling toward {FACTS.upscaleTarget} and spotlight graphics that make the athlete findable.</span>
          </li>
          <li class="flex gap-3">
            <span class="text-purple-400 shrink-0" aria-hidden="true">&#10003;</span>
            <span>
              Sharing by link, at full resolution. A viewer needs {FACTS.viewerRequirement}.
            </span>
          </li>
          <li class="flex gap-3">
            <span class="text-purple-400 shrink-0" aria-hidden="true">&#10003;</span>
            <span>Multiple aspect ratios from one set of clips, for recruiting cuts and social versions.</span>
          </li>
        </ul>
      </section>

      <section>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">What it deliberately does not do</h2>
        <p class="text-gray-300 leading-relaxed mb-4">
          ReelBallers does not sell cameras, and it does not require one. It has no hardware
          integrations. It accepts uploaded video files, which is why footage from
          {' '}{INPUT_SOURCES.length} broad categories of source all work the same way, including exports
          from team systems like Veo, Trace, and Hudl.
        </p>
        <p class="text-gray-300 leading-relaxed">
          It is also not a general video editor. If you want trending audio, caption animation, and a
          large effects library, a general-purpose editor will serve you better, and we say so
          plainly on the <a href="/vs/capcut" class="text-purple-400 hover:text-purple-300 transition-colors">comparison page</a>.
        </p>
      </section>

      <section>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">Who it is for</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <a href="/for-parents" class="bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl p-5 transition-all">
            <h3 class="font-bold text-white mb-1">Parents</h3>
            <p class="text-sm text-gray-400">Reels the family will actually watch, from phone footage.</p>
          </a>
          <a href="/recruiting-videos" class="bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl p-5 transition-all">
            <h3 class="font-bold text-white mb-1">Recruiting families</h3>
            <p class="text-sm text-gray-400">Three-to-five minute reels built for college coaches.</p>
          </a>
          <a href="/for-coaches" class="bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl p-5 transition-all">
            <h3 class="font-bold text-white mb-1">Coaches</h3>
            <p class="text-sm text-gray-400">One review pass, clips for the whole roster.</p>
          </a>
          <a href="/for-clubs" class="bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl p-5 transition-all">
            <h3 class="font-bold text-white mb-1">Clubs</h3>
            <p class="text-sm text-gray-400">Per-player reels from footage you already capture.</p>
          </a>
        </div>
      </section>

      <section>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">Sports supported</h2>
        <ul class="flex flex-wrap gap-3">
          {
            SPORTS.map((sport) => (
              <li>
                <a
                  href={`/${sport.slug}`}
                  class="inline-flex items-center gap-2 bg-white/5 hover:bg-white/10 border border-white/10 rounded-full px-4 py-2 text-sm text-gray-300 transition-all"
                >
                  <span aria-hidden="true">{sport.emoji}</span>
                  {sport.name}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">Contact</h2>
        <p class="text-gray-300 leading-relaxed">
          Email <a href={`mailto:${CONTACT_EMAIL}`} class="text-purple-400 hover:text-purple-300 transition-colors">{CONTACT_EMAIL}</a>{','}
          including to request a sport that is not yet supported.
        </p>
      </section>
    </div>
  </div>

  <Faq items={faqs} />

  <Cta />
</PageLayout>
