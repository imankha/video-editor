---
import PageLayout from '../layouts/PageLayout.astro'
import Faq from '../components/Faq.astro'
import Cta from '../components/Cta.astro'
import {
  LearnIllustration,
  ElevateIllustration,
  CelebrateIllustration,
} from '../components/Illustrations'
import { FACTS, HIGHLIGHT_REEL_LINE, INPUT_SOURCES, APP_URL, STEP_NAMES } from '../site'
import { faqPage, softwareApplication, webPage, breadcrumbs, howTo, type FaqItem } from '../lib/schema'

const path = '/how-it-works'

const steps = [
  {
    name: STEP_NAMES.upload,
    text: 'Upload the video you already filmed, a full game or a single play. There is no need to trim first, and no format conversion to do. Nothing installs; the editor runs in your browser.',
  },
  {
    name: STEP_NAMES.mark,
    text: 'Watch the game and mark each play worth keeping, tagging it with a play type, with a rating and optional notes. It takes about as long as watching the game.',
  },
  {
    name: STEP_NAMES.frame,
    text: `Choose the athlete each play is about, then drag the box over them a few times as the play develops. ReelBallers connects the motion in between, so a wide sideline shot becomes a tight, watchable frame. Tap Sharpen my highlight and it upscales toward ${FACTS.upscaleTarget}.`,
  },
  {
    name: STEP_NAMES.spotlight,
    text: 'Add a spotlight so a viewer knows immediately where to look.',
  },
  {
    name: STEP_NAMES.share,
    text: `Share your highlight with one link. A wide recruiting version and a vertical social version can come from the same play. ${HIGHLIGHT_REEL_LINE}`,
  },
]

const faqs: FaqItem[] = [
  {
    q: 'How long does making a highlight reel take?',
    a: 'The marking step takes roughly the length of the game, because you tag plays while watching it. Framing your athlete is a few drags per play, not frame-by-frame work. Sharpening happens after that without your involvement. There is no separate editing session.',
  },
  {
    q: 'Do I need any video editing experience?',
    a: 'No. There is no timeline to learn. You mark plays, choose who each play is about, and tap Sharpen my highlight.',
  },
  {
    q: 'What do I need to install?',
    a: FACTS.install,
  },
  {
    q: 'What video can I upload?',
    a: `Any standard video file: ${INPUT_SOURCES.join('; ')}. There is no hardware to buy and no integration to configure.`,
  },
  {
    q: 'Can I reuse my tagged plays?',
    a: 'Yes. Tagged plays go into a library, so you can come back and make another highlight from the same tagging work rather than marking the game again.',
  },
  {
    q: 'What does the person receiving the highlight need?',
    a: `Just ${FACTS.viewerRequirement}. The highlight plays at full resolution in a browser.`,
  },
]

const schemas = [
  softwareApplication(),
  webPage({ name: 'How ReelBallers works', description: 'The five steps from raw game video to a shareable highlight.', path }),
  breadcrumbs([{ name: 'How it works', path }]),
  howTo({
    name: 'How to turn game video into a highlight',
    description: 'Upload your game, mark the plays worth keeping, frame and spotlight your athlete, and share the highlight.',
    path,
    steps,
  }),
  faqPage(faqs),
]
---

<PageLayout
  title="How ReelBallers Works | From Game Video to Highlight"
  description="The five steps from a two-hour game video to a shareable highlight: upload, mark plays, frame, spotlight, share. No editing experience needed."
  path={path}
  schemas={schemas}
  trail={[{ name: 'How it works', path }]}
  current="/how-it-works"
>
  <section class="container mx-auto px-4 pt-10 pb-10">
    <div class="max-w-3xl">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-6 leading-tight">How ReelBallers works</h1>
      <p class="text-lg md:text-xl text-gray-300 leading-relaxed">
        Five steps. Upload your game, mark the plays worth keeping while you watch, frame and spotlight
        the athlete each play is about, and share the highlight with one link. See the{' '}
        <a href="/soccer" class="text-purple-400 hover:text-purple-300 font-medium transition-colors">soccer guide</a>{' '}
        for sport-specific detail, or{' '}
        <a href="/guides/filming-youth-sports-from-the-sideline" class="text-purple-400 hover:text-purple-300 font-medium transition-colors">
          how to film from the sideline
        </a>{' '}
        if you haven&rsquo;t recorded the game yet.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 mt-8">
        <a
          href={APP_URL}
          data-cta
          class="px-8 py-3 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold rounded-full text-lg text-center shadow-lg shadow-purple-500/25 transition-all"
        >
          Get started free
        </a>
      </div>
    </div>
  </section>

  <section class="container mx-auto px-4 py-12" aria-labelledby="steps-heading">
    <h2 id="steps-heading" class="sr-only">The five steps</h2>
    <ol class="space-y-6 max-w-3xl">
      {
        steps.map((step, i) => (
          <li id={`step-${i + 1}`} class="flex gap-5 bg-white/5 border border-white/10 rounded-2xl p-6">
            <span class="shrink-0 w-10 h-10 rounded-full bg-gradient-to-br from-purple-500 to-indigo-600 flex items-center justify-center text-white font-bold">
              {i + 1}
            </span>
            <div>
              <h3 class="text-xl font-bold text-white mb-2">{step.name}</h3>
              <p class="text-gray-300 leading-relaxed">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container mx-auto px-4 py-12 space-y-16" aria-labelledby="tour-heading">
    <h2 id="tour-heading" class="text-2xl md:text-3xl font-bold text-white text-center">
      See each step
    </h2>

    <div class="grid md:grid-cols-3 gap-8">
      <div>
        <div class="block w-full rounded-2xl mb-4">
          <LearnIllustration />
        </div>
        <h3 class="text-lg font-bold text-white mb-1">{STEP_NAMES.mark}</h3>
        <p class="text-sm text-gray-400">Mark plays, rate them, tag teammates, and leave notes.</p>
      </div>
      <div>
        <div class="block w-full rounded-2xl mb-4">
          <ElevateIllustration />
        </div>
        <h3 class="text-lg font-bold text-white mb-1">{STEP_NAMES.frame} and spotlight</h3>
        <p class="text-sm text-gray-400">Frame your athlete through the play and add a spotlight.</p>
      </div>
      <div>
        <div class="block w-full rounded-2xl mb-4">
          <CelebrateIllustration />
        </div>
        <h3 class="text-lg font-bold text-white mb-1">{STEP_NAMES.share}</h3>
        <p class="text-sm text-gray-400">One link, full resolution, no app required to watch.</p>
      </div>
    </div>
  </section>

  <Faq items={faqs} />

  <Cta />

</PageLayout>
