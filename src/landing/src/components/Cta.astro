---
/**
 * Closing call-to-action. `data-cta` marks links whose href gets the current
 * query string appended at runtime (see PageLayout) so attribution params
 * survive the hop to app.reelballers.com. Without JS the link still works --
 * it just loses the params, which is the correct graceful degradation.
 */
import { APP_URL } from '../site'

interface Props {
  heading?: string
  body?: string
  label?: string
}

const {
  heading = "Your player's next highlight reel is minutes away",
  body = 'Upload a game, mark the best moments, and share a pro-quality reel today. Free to start.',
  label = 'Get started free',
} = Astro.props
---

<section class="container mx-auto px-4 py-16">
  <div
    class="relative overflow-hidden bg-gradient-to-br from-purple-600/20 to-indigo-600/10 border border-white/10 rounded-2xl p-8 md:p-12 text-center max-w-3xl mx-auto"
  >
    <h2 class="text-2xl md:text-3xl font-bold text-white mb-3">{heading}</h2>
    <p class="text-gray-300 mb-8 max-w-xl mx-auto">{body}</p>
    <a
      href={APP_URL}
      data-cta
      class="inline-block px-8 py-3 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold rounded-full text-lg shadow-lg shadow-purple-500/25 transition-all"
    >
      {label}
    </a>
  </div>
</section>
