---
/**
 * Real, anonymised user quotes. See data/testimonials.ts for why these are
 * deliberately NOT marked up as Review/AggregateRating schema.
 */
import { testimonialsFor, type Testimonial } from '../data/testimonials'

interface Props {
  topics?: Testimonial['topic'][]
  heading?: string
}

const { topics = [], heading = 'What people are saying' } = Astro.props
const items = topics.length ? testimonialsFor(topics) : testimonialsFor([])
---

<section class="container mx-auto px-4 py-16" aria-labelledby="testimonials-heading">
  <h2 id="testimonials-heading" class="text-2xl md:text-3xl font-bold text-white mb-8 text-center">
    {heading}
  </h2>
  <div class="grid gap-6 md:grid-cols-2 max-w-4xl mx-auto">
    {
      items.map((t) => (
        <figure class="bg-white/5 backdrop-blur rounded-xl p-6 border border-white/10">
          <blockquote class="text-gray-300 leading-relaxed">{t.quote}</blockquote>
          <figcaption class="mt-4 text-sm font-semibold text-purple-400">{t.attribution}</figcaption>
        </figure>
      ))
    }
  </div>
</section>
