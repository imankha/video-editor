---
/**
 * Footer. Doubles as the site's internal link graph: every public page is
 * reachable from every other page in one hop, which is how a small site gets
 * fully crawled without relying on the sitemap alone.
 */
import { SPORTS } from '../data/sports'
import { CAMERAS } from '../data/cameras'
import { APP_URL, CONTACT_EMAIL, BRAND } from '../site'

const year = new Date().getFullYear()

const useCases = [
  { href: '/recruiting-videos', label: 'Recruiting videos' },
  { href: '/for-parents', label: 'For parents' },
  { href: '/for-coaches', label: 'For coaches' },
  { href: '/for-clubs', label: 'For clubs' },
]

const compare = [
  { href: '/vs/editing-by-hand', label: 'vs editing by hand' },
  { href: '/vs/capcut', label: 'vs CapCut' },
]

const company = [
  { href: '/about', label: 'About' },
  { href: '/how-it-works', label: 'How it works' },
  { href: '/guides', label: 'Guides' },
]
---

<footer class="border-t border-white/10 mt-8">
  <div class="container mx-auto px-4 py-12">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-5 text-sm">
      <div>
        <h2 class="font-semibold text-white mb-3">Sports</h2>
        <ul class="space-y-2">
          {
            SPORTS.map((s) => (
              <li>
                <a href={`/${s.slug}`} class="text-gray-400 hover:text-white transition-colors">
                  {s.name} highlights
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="font-semibold text-white mb-3">Use cases</h2>
        <ul class="space-y-2">
          {
            useCases.map((l) => (
              <li>
                <a href={l.href} class="text-gray-400 hover:text-white transition-colors">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="font-semibold text-white mb-3">Works with</h2>
        <ul class="space-y-2">
          {
            CAMERAS.map((c) => (
              <li>
                <a href={`/works-with/${c.slug}`} class="text-gray-400 hover:text-white transition-colors">
                  {c.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="font-semibold text-white mb-3">Compare</h2>
        <ul class="space-y-2">
          {
            compare.map((l) => (
              <li>
                <a href={l.href} class="text-gray-400 hover:text-white transition-colors">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="font-semibold text-white mb-3">Company</h2>
        <ul class="space-y-2">
          {
            company.map((l) => (
              <li>
                <a href={l.href} class="text-gray-400 hover:text-white transition-colors">
                  {l.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href={`mailto:${CONTACT_EMAIL}`} class="text-gray-400 hover:text-white transition-colors">
              Contact
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-500">
      <p>&copy; {year} {BRAND}. All rights reserved.</p>
      <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1">
        <a href={`${APP_URL}/privacy`} class="hover:text-gray-300 transition-colors">Privacy Policy</a>
        <a href={`${APP_URL}/terms`} class="hover:text-gray-300 transition-colors">Terms of Service</a>
        <a href={`${APP_URL}/privacy#your-rights`} class="hover:text-gray-300 transition-colors">
          Do Not Sell or Share
        </a>
      </div>
    </div>
  </div>
</footer>
