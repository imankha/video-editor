---
/**
 * FAQ block. Uses <details>/<summary> so answers are in the HTML (crawlable and
 * quotable) with zero JavaScript -- the whole point is that an AI crawler with
 * no JS still reads every answer.
 *
 * The page must ALSO pass faqPage(items) to BaseLayout's `schemas` prop.
 * Visible copy and FAQPage markup must match; markup without visible text is a
 * structured-data violation.
 */
import type { FaqItem } from '../lib/schema'

interface Props {
  items: FaqItem[]
  heading?: string
  id?: string
}

const { items, heading = 'Frequently asked questions', id = 'faq' } = Astro.props
---

<section id={id} class="max-w-3xl mx-auto px-4 py-16" aria-labelledby={`${id}-heading`}>
  <h2 id={`${id}-heading`} class="text-2xl md:text-3xl font-bold text-white mb-8">{heading}</h2>
  <div class="divide-y divide-white/10 border-y border-white/10">
    {
      items.map((item, i) => (
        <details class="group py-4" open={i === 0}>
          <summary class="flex items-start justify-between gap-4 cursor-pointer list-none text-left">
            <h3 class="text-base md:text-lg font-semibold text-white">{item.q}</h3>
            <span
              class="shrink-0 mt-1 text-purple-400 transition-transform group-open:rotate-45"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <p class="mt-3 text-gray-300 leading-relaxed">{item.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  /* Hide the native disclosure triangle without hiding the summary itself. */
  summary::-webkit-details-marker {
    display: none;
  }
</style>
