---
/**
 * The layout every content page uses: BaseLayout's <head> plus header, a real
 * <main>, and the footer link graph.
 *
 * Semantic landmarks (<header>/<nav>/<main>/<footer>) are here rather than in
 * each page so no page can forget them.
 */
import BaseLayout from './BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'

export interface Props {
  title: string
  description: string
  path: string
  image?: string
  ogType?: 'website' | 'article'
  schemas?: Record<string, unknown>[]
  dateModified?: string
  noindex?: boolean
  /** Breadcrumb trail excluding Home. Omit on the homepage. */
  trail?: { name: string; path: string }[]
  /** Nav item to mark as current. */
  current?: string
  /** Set only by a per-sport page: the sport id (tagRegistry key, the same key the
   * admin Sport filter uses). T14930 fills it into `utm_content` when the visit has none
   * (an ad's own value always wins); T7410's beacon reports `landing:<sport>`. */
  sport?: string
}

const { trail, current, sport, ...base } = Astro.props
---

<BaseLayout {...base}>
  <Header current={current} />
  {trail && trail.length > 0 && <Breadcrumbs trail={trail} />}
  <main id="main" data-sport={sport}>
    <slot />
  </main>
  <Footer />

  <!--
    Carry attribution params across to the app (a different host), surviving
    a multi-page visit: T15000 writes a per-tab first-touch record on the
    FIRST page and merges it into every a[data-cta] href on every page after
    that (see src/attribution.ts for the policy). T14930: a sport page also
    fills `utm_content` with its sport key the first time one is seen, via the
    `data-sport` attribute above (kept out of the module script's closure so
    the script itself never changes per page). Progressive enhancement:
    without JS, or with storage blocked, the CTA still links correctly, it
    just loses the params.
  -->
  <script>
    import { readFirstTouch, applyFirstTouch, applyArrivalSport, sendVisitBeacon } from '../attribution'
    import { API_URL } from '../site'

    const sportKey = document.getElementById('main')?.dataset.sport || null
    let record = null
    try {
      record = readFirstTouch(
        window.location.search,
        document.referrer,
        window.location.hostname,
        window.location.pathname,
        window.sessionStorage,
      )
      const withSport = sportKey ? applyArrivalSport(record, sportKey, window.sessionStorage) : record
      document.querySelectorAll<HTMLAnchorElement>('a[data-cta]').forEach((a) => {
        try {
          a.href = applyFirstTouch(a.href, withSport)
        } catch {
          /* leave the href untouched */
        }
      })
    } catch {
      /* storage unavailable — links keep their default href */
    }

    // T7410: anonymous visit beacon, fired once per page load regardless of
    // whether the first-touch record above was readable (sendVisitBeacon
    // tolerates a null record -- it just has no attribution hints to send).
    sendVisitBeacon(record, sportKey ? `landing:${sportKey}` : 'landing', API_URL)
  </script>
</BaseLayout>
